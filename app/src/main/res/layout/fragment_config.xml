<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Voltar -->
        <TextView
            android:id="@+id/btnVoltar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← Voltar"
            android:textColor="#8E4A5A"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Título -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Configurações"
            android:textColor="#542B35"
            android:textSize="28sp"
            android:textStyle="bold" />

        <!-- Conta -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:text="Conta"
            android:textColor="#542B35"
            android:textSize="19sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnEditarConta"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="#F3DDE3"
            android:text="👤  Editar conta"
            android:textColor="#8E4A5A"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnAlterarSenha"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="#F3DDE3"
            android:text="🔒  Alterar senha"
            android:textColor="#8E4A5A"
            android:textSize="16sp" />

        <!-- Preferências -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="Preferências"
            android:textColor="#542B35"
            android:textSize="19sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnNotificacoes"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="#F3DDE3"
            android:text="🔔  Notificações"
            android:textColor="#8E4A5A"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnIdioma"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="#F3DDE3"
            android:text="🌐  Idioma: Português"
            android:textColor="#8E4A5A"
            android:textSize="16sp" />

        <!-- Ajuda -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="Ajuda e informações"
            android:textColor="#542B35"
            android:textSize="19sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnAjuda"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="#F3DDE3"
            android:text="❓  Central de ajuda"
            android:textColor="#8E4A5A"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btnSobre"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="#F3DDE3"
            android:text="ℹ  Sobre o aplicativo"
            android:textColor="#8E4A5A"
            android:textSize="16sp" />

        <!-- Sair -->
        <Button
            android:id="@+id/btnSair"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="20dp"
            android:backgroundTint="#A84D67"
            android:text="Sair da conta"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>